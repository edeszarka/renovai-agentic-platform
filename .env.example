# Google API Key for Gemini and Embeddings
GOOGLE_API_KEY=your_google_api_key_here

# DeepSeek API (for Text-to-SQL — free 5M token grant on signup)
# Get key at: platform.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_SQL_MODEL=deepseek-chat

# Path to Vector DB
CHROMA_DB_PATH=./data/chroma_db

# Data paths
RAW_DATA_PATH=./data/raw
PROCESSED_DATA_PATH=./data/processed

# Database URL (SQLite for POC)
DATABASE_URL=sqlite+aiosqlite:///data/renovai.db
